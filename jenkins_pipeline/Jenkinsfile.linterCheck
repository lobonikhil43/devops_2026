@Library('devops_2026') _

pipeline {
    agent { label 'builder' }

    environment {
        GITHUB_REPO = 'lobonikhil43/devops_2026'
    }

    stages {

        stage('Agent Details') {
            steps {
                agentDetails()
            }
        }

        stage('Lint') {
            parallel {

                stage('Dockerfile') {
                    steps {
                        script {
                            env.DOCKERFILE_STATUS = '❌ FAILED'
                            try {
                                lintDockerfile()
                                env.DOCKERFILE_STATUS = '✅ PASSED'
                            } catch (e) {}
                        }
                    }
                }

                stage('Python') {
                    steps {
                        script {
                            env.PYTHON_STATUS = '❌ FAILED'
                            try {
                                lintPython()
                                env.PYTHON_STATUS = '✅ PASSED'
                            } catch (e) {}
                        }
                    }
                }

                stage('Bash') {
                    steps {
                        script {
                            env.BASH_STATUS = '❌ FAILED'
                            try {
                                lintBash()
                                env.BASH_STATUS = '✅ PASSED'
                            } catch (e) {}
                        }
                    }
                }

                stage('Groovy') {
                    steps {
                        script {
                            env.GROOVY_STATUS = '❌ FAILED'
                            try {
                                lintGroovy()
                                env.GROOVY_STATUS = '✅ PASSED'
                            } catch (e) {}
                        }
                    }
                }

                stage('JSON') {
                    steps {
                        script {
                            env.JSON_STATUS = '❌ FAILED'
                            try {
                                lintJson()
                                env.JSON_STATUS = '✅ PASSED'
                            } catch (e) {}
                        }
                    }
                }

                stage('YAML') {
                    steps {
                        script {
                            env.YAML_STATUS = '❌ FAILED'
                            try {
                                lintYaml()
                                env.YAML_STATUS = '✅ PASSED'
                            } catch (e) {}
                        }
                    }
                }
            }
        }

        stage('PR Comment (GitHub Check Status)') {
            steps {
                script {

                    def allPassed =
                        env.DOCKERFILE_STATUS?.contains('PASSED') &&
                        env.PYTHON_STATUS?.contains('PASSED') &&
                        env.BASH_STATUS?.contains('PASSED') &&
                        env.GROOVY_STATUS?.contains('PASSED') &&
                        env.JSON_STATUS?.contains('PASSED') &&
                        env.YAML_STATUS?.contains('PASSED')

                    def statusMsg = allPassed
                        ? "✅ All checks passed — ready for merge"
                        : "❌ Some checks failed — fix required"

                    def message = """
## Jenkins Lint Report

|    Type    |   Status  |
|------------|-----------|
| Dockerfile | ${env.DOCKERFILE_STATUS} |
| Python     | ${env.PYTHON_STATUS} |
| Bash       | ${env.BASH_STATUS} |
| Groovy     | ${env.GROOVY_STATUS} |
| JSON       | ${env.JSON_STATUS} |
| YAML       | ${env.YAML_STATUS} |

### ${statusMsg}

Build: ${env.BUILD_URL}
""".trim()

                    githubComment(
                        credentialsId: 'github-token',
                        repo: env.GITHUB_REPO,
                        prNumber: env.CHANGE_ID,
                        message: message
                    )
                }
            }
        }

        stage('Auto Rebase Feature Branch (Optional)') {
            when {
                expression {
                    return env.BRANCH_NAME != 'main'
                }
            }

            steps {
                sh '''
                    set +e
                    git config user.email "jenkins@local"
                    git config user.name "jenkins-bot"

                    git fetch origin main
                    git checkout ${BRANCH_NAME}
                    git rebase origin/main || true
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline successful"
        }

        failure {
            script {
                githubComment(
                    credentialsId: 'github-token',
                    repo: env.GITHUB_REPO,
                    prNumber: env.CHANGE_ID,
                    message: "❌ Build failed: ${env.BUILD_URL}"
                )
            }
        }
    }
}