@Library('devops_2026') _

pipeline {
    agent { label 'builder' }

    environment {
        GITHUB_REPO = 'lobonikhil43/devops_2026'
        PATH = "$HOME/.local/bin:$PATH"
    }

    stages {

        stage('Agent Details') {
            steps {
                agentDetails()
            }
        }

        stage('Lint') {
            parallel {

                stage('Dockerfile') {
                    steps {
                        script {
                            env.DOCKERFILE_STATUS = '❌ FAILED'
                            lintDockerfile()
                            env.DOCKERFILE_STATUS = '✅ PASSED'
                        }
                    }
                }

                stage('Python') {
                    steps {
                        script {
                            env.PYTHON_STATUS = '❌ FAILED'
                            lintPython()
                            env.PYTHON_STATUS = '✅ PASSED'
                        }
                    }
                }

                stage('Bash') {
                    steps {
                        script {
                            env.BASH_STATUS = '❌ FAILED'
                            lintBash()
                            env.BASH_STATUS = '✅ PASSED'
                        }
                    }
                }

                stage('Groovy') {
                    steps {
                        script {
                            env.GROOVY_STATUS = '❌ FAILED'
                            lintGroovy()
                            env.GROOVY_STATUS = '✅ PASSED'
                        }
                    }
                }

                stage('JSON') {
                    steps {
                        script {
                            env.JSON_STATUS = '❌ FAILED'
                            lintJson()
                            env.JSON_STATUS = '✅ PASSED'
                        }
                    }
                }

                stage('YAML') {
                    steps {
                        script {
                            env.YAML_STATUS = '❌ FAILED'
                            lintYaml()
                            env.YAML_STATUS = '✅ PASSED'
                        }
                    }
                }
            }
        }

        stage('PR Comment') {
            when {
                expression { return env.CHANGE_ID != null }
            }

            steps {
                script {

                    def prNumber = env.CHANGE_ID

                    def allPassed =
                        (env.DOCKERFILE_STATUS ?: '').contains('PASSED') &&
                        (env.PYTHON_STATUS ?: '').contains('PASSED') &&
                        (env.BASH_STATUS ?: '').contains('PASSED') &&
                        (env.GROOVY_STATUS ?: '').contains('PASSED') &&
                        (env.JSON_STATUS ?: '').contains('PASSED') &&
                        (env.YAML_STATUS ?: '').contains('PASSED')

                    def statusMsg = allPassed
                        ? "✅ All checks passed — ready for merge"
                        : "❌ Some checks failed — fix required"

                    def message = """
## 🔍 Jenkins Lint Report

| Type | Status |
|------|--------|
| Dockerfile | ${env.DOCKERFILE_STATUS} |
| Python     | ${env.PYTHON_STATUS} |
| Bash       | ${env.BASH_STATUS} |
| Groovy     | ${env.GROOVY_STATUS} |
| JSON       | ${env.JSON_STATUS} |
| YAML       | ${env.YAML_STATUS} |

### ${statusMsg}

Build: ${env.BUILD_URL}
""".trim()

                    withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {

                        writeFile file: 'comment.txt', text: message

                        sh '''
                            set +e

                            echo "Posting PR comment for PR: $CHANGE_ID"

                            BODY=$(cat comment.txt)

                            JSON=$(jq -n --arg body "$BODY" '{body: $body}')

                            curl -s -o response.json -w "%{http_code}" \
                              -X POST \
                              -H "Authorization: token $GITHUB_TOKEN" \
                              -H "Accept: application/vnd.github+json" \
                              -H "Content-Type: application/json" \
                              --data "$JSON" \
                              "https://api.github.com/repos/${GITHUB_REPO}/issues/${CHANGE_ID}/comments"

                            echo "Response:"
                            cat response.json
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline successful"
        }

        failure {
            script {
                echo "❌ Build failed: ${env.BUILD_URL}"
            }
        }
    }
}