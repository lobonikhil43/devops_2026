@Library('devops_2026') _

pipeline {
    agent { label 'builder' }

    environment {
        GITHUB_TOKEN = credentials('github-token')
        GITHUB_REPO  = 'lobonikhil43/devops_2026'
    }

    triggers {
        githubPullRequest(
            triggerPhrase: 'recheck',
            useGitHubHooks: true,
            permitAll: false,
            whiteListTargetBranches: [
                [branch: 'main']
            ]
        )
    }

    stages {
        stage('Agent Details') {
            steps {
                agentDetails()
            }
        }

        stage('Lint') {
            parallel {
                stage('Dockerfile') {
                    steps {
                        script {
                            try {
                                lintDockerfile()
                                env.DOCKERFILE_STATUS = '✅ PASSED'
                            } catch(e) {
                                env.DOCKERFILE_STATUS = '❌ FAILED'
                            }
                        }
                    }
                }
                stage('Python') {
                    steps {
                        script {
                            try {
                                lintPython()
                                env.PYTHON_STATUS = '✅ PASSED'
                            } catch(e) {
                                env.PYTHON_STATUS = '❌ FAILED'
                            }
                        }
                    }
                }
                stage('Bash') {
                    steps {
                        script {
                            try {
                                lintBash()
                                env.BASH_STATUS = '✅ PASSED'
                            } catch(e) {
                                env.BASH_STATUS = '❌ FAILED'
                            }
                        }
                    }
                }
                stage('Groovy') {
                    steps {
                        script {
                            try {
                                lintGroovy()
                                env.GROOVY_STATUS = '✅ PASSED'
                            } catch(e) {
                                env.GROOVY_STATUS = '❌ FAILED'
                            }
                        }
                    }
                }
                stage('JSON') {
                    steps {
                        script {
                            try {
                                lintJson()
                                env.JSON_STATUS = '✅ PASSED'
                            } catch(e) {
                                env.JSON_STATUS = '❌ FAILED'
                            }
                        }
                    }
                }
                stage('YAML') {
                    steps {
                        script {
                            try {
                                lintYaml()
                                env.YAML_STATUS = '✅ PASSED'
                            } catch(e) {
                                env.YAML_STATUS = '❌ FAILED'
                            }
                        }
                    }
                }
            }
        }

        stage('PR Comment') {
            steps {
                script {
                    def allPassed = 
                        env.DOCKERFILE_STATUS.contains('PASSED') &&
                        env.PYTHON_STATUS.contains('PASSED')     &&
                        env.BASH_STATUS.contains('PASSED')       &&
                        env.GROOVY_STATUS.contains('PASSED')     &&
                        env.JSON_STATUS.contains('PASSED')       &&
                        env.YAML_STATUS.contains('PASSED')

                    def status  = allPassed ? '✅ All checks passed — Ready to merge!' : '❌ Some checks failed — Please fix lint errors!'

                    def message = """
## 🔍 Jenkins Lint Review\\n\\n
| File Type  | Status |\\n
|------------|--------|\\n
| Dockerfile | ${env.DOCKERFILE_STATUS} |\\n
| Python     | ${env.PYTHON_STATUS}     |\\n
| Bash       | ${env.BASH_STATUS}       |\\n
| Groovy     | ${env.GROOVY_STATUS}     |\\n
| JSON       | ${env.JSON_STATUS}       |\\n
| YAML       | ${env.YAML_STATUS}       |\\n\\n
### ${status}\\n
> Build: ${env.BUILD_URL}
                    """.trim()

                    githubComment(
                        token    : env.GITHUB_TOKEN,
                        repo     : env.GITHUB_REPO,
                        prNumber : env.CHANGE_ID,
                        message  : message
                    )
                }
            }
        }

        stage('Merge') {
            when {
                expression {
                    return env.DOCKERFILE_STATUS.contains('PASSED') &&
                           env.PYTHON_STATUS.contains('PASSED')     &&
                           env.BASH_STATUS.contains('PASSED')       &&
                           env.GROOVY_STATUS.contains('PASSED')     &&
                           env.JSON_STATUS.contains('PASSED')       &&
                           env.YAML_STATUS.contains('PASSED')
                }
            }
            steps {
                sh '''#!/bin/bash
                    set +x
                    exec 2>/dev/null
                    echo "=============================="
                    echo "  ✅ All checks passed!"
                    echo "  🔀 Merging PR to main..."
                    echo "=============================="
                    git config user.email "jenkins@devops.com"
                    git config user.name "Jenkins"
                    git checkout main
                    git merge --no-ff $GIT_BRANCH -m "Auto merge: all lint checks passed"
                    git push origin main
                    echo "  ✅ Merged successfully!"
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Review passed - PR merged to main!'
        }
        failure {
            script {
                githubComment(
                    token    : env.GITHUB_TOKEN,
                    repo     : env.GITHUB_REPO,
                    prNumber : env.CHANGE_ID,
                    message  : '❌ Jenkins build failed — check build logs: ' + env.BUILD_URL
                )
            }
        }
    }
}
